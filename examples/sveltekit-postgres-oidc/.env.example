# Harmless dummy values for development and for the build. The real values come from it25a.yml and from
# the GitHub secrets on the server. The secrets are long enough to pass the checks in src/env.ts.
ORIGIN=http://localhost:3000
AUTH_SECRET=dummy-secret-for-development-only
OIDC_ISSUER=http://localhost:9000
OIDC_CLIENT_ID=my-app
OIDC_CLIENT_SECRET=dummy-secret-for-development-only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=notes
POSTGRES_USER=notes_app
POSTGRES_PASSWORD=dummy-password-for-development
